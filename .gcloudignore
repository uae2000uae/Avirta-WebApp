# Files NOT uploaded to Cloud Run by `gcloud run deploy --source .` (Cloud Build).
# Same syntax as .gitignore. Keep runtime data (contents/, datastore/,
# questionmanagement/) — the app reads and writes it.
.gcloudignore
.git
.gitignore
.gitleaks.toml
.github/
.venv/
.idea/
.junie/
.aiassistant/
.claude/
.pytest_cache/
__pycache__/
*.py[cod]
.env
.env.*
tests/
docs/
pytest.ini
requirements-dev.txt
.flake8
README.md
